{
	"name": "dataflow1",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "Json2",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "Parquet1",
						"type": "DatasetReference"
					},
					"name": "source3"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "Parquet2",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          orderId as string,",
				"          orderDate as string,",
				"          customer as (customerId as string, name as string, email as string, address as (city as string, state as string, country as string, pincode as string)),",
				"          items as (sku as string, productName as string, quantity as integer, unitPrice as double)[],",
				"          totalAmount as double,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     documentForm: 'arrayOfDocuments') ~> source1",
				"source(output(",
				"          orderId as string,",
				"          orderDate as timestamp,",
				"          customerId as string,",
				"          customerName as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          pincode as string,",
				"          sku as string,",
				"          productName as string,",
				"          quantity as integer,",
				"          unitPrice as double,",
				"          status as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     format: 'parquet') ~> source3",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          orderId as string,",
				"          orderDate as timestamp,",
				"          customerId as string,",
				"          customerName as string,",
				"          email as string,",
				"          city as string,",
				"          state as string,",
				"          country as string,",
				"          pincode as string,",
				"          sku as string,",
				"          productName as string,",
				"          quantity as integer,",
				"          unitPrice as double,",
				"          status as string",
				"     ),",
				"     format: 'parquet',",
				"     rowUrlColumn:'',",
				"     umask: 0777,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}