{
	"name": "AzureSqlDatabaseLS",
	"properties": {
		"parameters": {
			"servername": {
				"type": "string",
				"defaultValue": "@pipeline().globalParameters.GlobalServerName"
			},
			"DBname": {
				"type": "string",
				"defaultValue": "@pipeline().globalParameters. GlobalDatabaseName"
			},
			"username": {
				"type": "string",
				"defaultValue": "@pipeline().globalParameters. GlobalSqlUsername"
			}
		},
		"annotations": [],
		"type": "AzureSqlDatabase",
		"typeProperties": {
			"server": "@{linkedService().servername}",
			"database": "@{linkedService().DBname}",
			"encrypt": "mandatory",
			"trustServerCertificate": false,
			"authenticationType": "SQL",
			"userName": "@{linkedService().username}",
			"password": {
				"type": "AzureKeyVaultSecret",
				"store": {
					"referenceName": "KeyVaultLinkService",
					"type": "LinkedServiceReference"
				},
				"secretName": "sqlpassword",
				"secretVersion": "a57e7b13e7384cc6a32973c968ccbc0d"
			},
			"alwaysEncryptedSettings": {
				"alwaysEncryptedAkvAuthType": "ManagedIdentity"
			}
		}
	}
}